{
  "schema": 1,
  "id": "uikit",
  "name": "UI Kit",
  "version": "2.0.0",
  "description": "Every NickelDrawer component with sample content, for developers and testers",
  "hidden": true,
  "storage": {
    "reads": [
      "pictures"
    ]
  },
  "network": false,
  "actions": [
    {
      "id": "state",
      "label": "State",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "echo",
      "label": "Echo the event",
      "run": "bin/echo.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "dialog",
      "label": "Show the info dialog",
      "run": "bin/dialog.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "toast",
      "label": "Show a toast",
      "run": "bin/toast.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "steps",
      "label": "Run 3 steps",
      "run": "bin/steps.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "refresh",
      "label": "Rescan pictures",
      "run": "bin/refresh.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "autorescan",
      "label": "Auto-update switch",
      "run": "bin/autorescan.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "sampleenabled",
      "label": "Enabled switch",
      "run": "bin/sampleenabled.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "shownote",
      "label": "Notice switch",
      "run": "bin/shownote.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "refreshmode",
      "label": "Page refresh option",
      "run": "bin/refreshmode.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "searchtext",
      "label": "Search text",
      "run": "bin/searchtext.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "pagenumber",
      "label": "Page number",
      "run": "bin/pagenumber.sh",
      "output": "show",
      "timeout_ms": 3000
    }
  ]
}
