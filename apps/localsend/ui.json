{
  "kit": 1,
  "start": "main",
  "vars": {
    "status": "",
    "running": false,
    "pin": "",
    "device": "",
    "ip": "",
    "summary": "",
    "received": [],
    "note": ""
  },
  "screens": {
    "main": {
      "title": "LocalSend",
      "status": "$status",
      "body": [
        {
          "bigcode": "$pin",
          "digits": 4
        },
        {
          "text": "@ui.pin_hint",
          "style": "caption",
          "align": "center"
        },
        {
          "kv": [
            [
              "@ui.device",
              "$device"
            ],
            [
              "@ui.ip",
              "$ip"
            ]
          ]
        },
        {
          "notice": "@ui.keep_awake"
        },
        {
          "text": "@ui.idle_stop",
          "style": "caption"
        },
        {
          "notice": "$note"
        },
        {
          "text": "$summary",
          "style": "caption"
        },
        {
          "list": "$received",
          "title": "@ui.received",
          "empty_text": "@ui.nothing_yet",
          "max": 10
        }
      ],
      "footer": [
        {
          "button": "@ui.start",
          "action": "start",
          "style": "secondary",
          "enabled": "!$running"
        },
        {
          "button": "@ui.stop_and_update",
          "action": "stop",
          "style": "primary",
          "enabled": "$running"
        }
      ],
      "toasts": {
        "started": "@ui.toast_started",
        "stopped": "@ui.toast_stopped",
        "wifi_missing": "@ui.toast_wifi_missing",
        "start_failed": "@ui.toast_start_failed",
        "failed": "@ui.toast_failed"
      }
    }
  }
}
