{
  "schema": 1,
  "id": "localsend",
  "name": "LocalSend",
  "version": "1.0.0",
  "description": "Receive books and files from your phone with LocalSend",
  "storage": { "reads": ["inbox"], "writes": ["inbox", "rejected", "books", "documents", "comics", "pictures"] },
  "network": true,
  "actions": [
    {
      "id": "start",
      "label": "Start receiving",
      "run": "bin/start.sh",
      "output": "show",
      "timeout_ms": 9500,
      "wifi": true,
      "rescan": "none"
    },
    {
      "id": "stop",
      "label": "Stop receiving",
      "run": "bin/stop.sh",
      "output": "show",
      "timeout_ms": 5000,
      "rescan": "quick"
    },
    {
      "id": "sort",
      "label": "Sort old files",
      "run": "bin/sort.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "quick",
      "menu": false
    },
    {
      "id": "state",
      "label": "Screen state",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 1000,
      "rescan": "none",
      "menu": false
    }
  ]
}
