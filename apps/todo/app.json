{
  "schema": 1,
  "id": "todo",
  "name": "To-do",
  "version": "1.0.0",
  "description": "A small to-do list that stays on your Kobo",
  "storage": {
    "reads": [],
    "writes": []
  },
  "network": false,
  "actions": [
    {
      "id": "newitem",
      "label": "New task",
      "run": "bin/newitem.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "toggle",
      "label": "Mark done or open",
      "run": "bin/toggle.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "remove",
      "label": "Delete task",
      "run": "bin/remove.sh",
      "output": "show",
      "timeout_ms": 3000,
      "confirm": "Delete this task?"
    },
    {
      "id": "clear-done",
      "label": "Clear done tasks",
      "run": "bin/clear-done.sh",
      "output": "show",
      "timeout_ms": 3000,
      "confirm": "Clear all done tasks?",
      "menu": true
    },
    {
      "id": "state",
      "label": "State",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 3000
    }
  ]
}
