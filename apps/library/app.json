{
  "schema": 1,
  "id": "library",
  "name": "Library",
  "version": "0.2.0",
  "description": "Fix the language of Vietnamese books and find duplicate books",
  "storage": {
    "reads": [
      "books",
      "documents",
      "comics"
    ],
    "writes": [
      "books",
      "documents",
      "comics"
    ]
  },
  "network": false,
  "actions": [
    {
      "id": "scan",
      "label": "Scan",
      "run": "bin/scan.sh",
      "output": "show",
      "timeout_ms": 9500,
      "rescan": "none"
    },
    {
      "id": "fix",
      "label": "Fix language",
      "run": "bin/fix.sh",
      "output": "show",
      "timeout_ms": 9500,
      "rescan": "none",
      "menu": false,
      "confirm": "Fix the language of the selected books?"
    },
    {
      "id": "undo",
      "label": "Undo last fix",
      "run": "bin/undo.sh",
      "output": "show",
      "timeout_ms": 9500,
      "rescan": "none",
      "menu": false,
      "confirm": "Undo the last language fix?"
    },
    {
      "id": "normalize",
      "label": "Fix names (NFC)",
      "run": "bin/normalize.sh",
      "output": "show",
      "timeout_ms": 9500,
      "rescan": "none",
      "menu": false,
      "confirm": "Rename files to the NFC form?"
    },
    {
      "id": "pick",
      "label": "Select duplicate",
      "run": "bin/pick.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "page",
      "label": "Next page",
      "run": "bin/page.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "trash",
      "label": "Move to trash",
      "run": "bin/trash.sh",
      "output": "show",
      "timeout_ms": 5000,
      "rescan": "none",
      "menu": false,
      "confirm": "Move the selected book to the trash?"
    },
    {
      "id": "restore",
      "label": "Restore from trash",
      "run": "bin/restore.sh",
      "output": "show",
      "timeout_ms": 5000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "cancel",
      "label": "Stop",
      "run": "bin/cancel.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "state",
      "label": "State",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 1000,
      "rescan": "none",
      "menu": false
    }
  ],
  "requests": [
    "rescan"
  ]
}
