{
  "kit": 1,
  "start": "main",
  "vars": {
    "status": "",
    "books": "0",
    "wrong": "0",
    "not_nfc": "0",
    "groups": "0",
    "last_scan": "",
    "running": false,
    "phase": "",
    "done": "0",
    "total": "0",
    "detail": "",
    "can_fix": false,
    "can_undo": false,
    "has_pages": false,
    "has_selection": false,
    "selected": "",
    "duplicates": [],
    "can_normalize": false,
    "can_restore": false,
    "can_stop": false
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "status": "$status",
      "body": [
        {
          "kv": [
            [
              "@ui.books",
              "$books"
            ],
            [
              "@ui.wrong",
              "$wrong"
            ],
            [
              "@ui.not_nfc",
              "$not_nfc"
            ],
            [
              "@ui.groups",
              "$groups"
            ],
            [
              "@ui.last_scan",
              "$last_scan"
            ]
          ]
        },
        {
          "steps": {
            "label": "$phase",
            "done": "$done",
            "total": "$total",
            "detail": "$detail"
          }
        },
        {
          "row": "@ui.fix",
          "action": "fix",
          "confirm": {
            "text": "@ui.fix_confirm",
            "ok": "@ui.fix_ok",
            "cancel": "@ui.cancel"
          },
          "show": "$can_fix"
        },
        {
          "row": "@ui.nfc",
          "action": "normalize",
          "confirm": {
            "text": "@ui.nfc_confirm",
            "ok": "@ui.nfc_ok",
            "cancel": "@ui.cancel"
          },
          "show": "$can_normalize"
        },
        {
          "row": "@ui.undo",
          "action": "undo",
          "confirm": {
            "text": "@ui.undo_confirm",
            "ok": "@ui.undo_ok",
            "cancel": "@ui.cancel"
          },
          "show": "$can_undo"
        },
        {
          "list": "$duplicates",
          "title": "@ui.duplicates",
          "empty_text": "@ui.no_duplicates",
          "tap": "pick",
          "max": 30
        },
        {
          "row": "@ui.next_page",
          "action": "page",
          "show": "$has_pages"
        },
        {
          "text": "$selected",
          "style": "caption"
        },
        {
          "row": "@ui.trash",
          "action": "trash",
          "confirm": {
            "text": "@ui.trash_confirm",
            "ok": "@ui.trash_ok",
            "cancel": "@ui.cancel"
          },
          "show": "$has_selection"
        },
        {
          "row": "@ui.restore",
          "action": "restore",
          "confirm": {
            "text": "@ui.restore_confirm",
            "ok": "@ui.restore_ok",
            "cancel": "@ui.cancel"
          },
          "show": "$can_restore"
        },
        {
          "notice": "@ui.note"
        }
      ],
      "footer": [
        {
          "button": "@ui.scan",
          "action": "scan",
          "style": "primary",
          "show": "!$running",
          "async": true
        },
        {
          "button": "@ui.stop",
          "action": "cancel",
          "style": "primary",
          "show": "$running",
          "enabled": "$can_stop"
        }
      ],
      "toasts": {
        "started": "@ui.toast_started",
        "busy": "@ui.toast_busy",
        "trashed": "@ui.toast_trashed",
        "failed": "@ui.toast_failed",
        "stopping": "@ui.toast_stopping",
        "restored": "@ui.toast_restored"
      }
    }
  }
}
