{
  "kit": 1,
  "start": "main",
  "vars": {
    "status": "",
    "configured": false,
    "guide": "",
    "repo": "",
    "branch": "",
    "folder": "",
    "last_sync": "",
    "added": "",
    "summary": "",
    "last_error": "",
    "running": false,
    "can_sync": false,
    "progress": "",
    "step_detail": "",
    "pairing": false,
    "pair_row": "",
    "pair_url": "",
    "pair_code": "",
    "pair_expires": "",
    "pair_hint": "",
    "pair_note": "",
    "step_done": "",
    "step_total": ""
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "status": "$status",
      "body": [
        {
          "notice": "$guide",
          "title": "@ui.guide_title"
        },
        {
          "kv": [
            [
              "@ui.repo",
              "$repo"
            ],
            [
              "@ui.branch",
              "$branch"
            ],
            [
              "@ui.folder",
              "$folder"
            ],
            [
              "@ui.last_sync",
              "$last_sync"
            ],
            [
              "@ui.added",
              "$added"
            ]
          ]
        },
        {
          "text": "$summary",
          "style": "caption"
        },
        {
          "notice": "$last_error",
          "title": "@ui.error_title"
        },
        {
          "steps": {
            "label": "$progress",
            "done": "$step_done",
            "total": "$step_total",
            "detail": "$step_detail"
          }
        },
        {
          "row": "@ui.pair_row",
          "detail": "$pair_row",
          "push": "pair",
          "show": "$configured"
        }
      ],
      "footer": [
        {
          "button": "@ui.pair_row",
          "push": "pair",
          "style": "primary",
          "show": "!$configured"
        },
        {
          "button": "@ui.sync",
          "action": "sync",
          "style": "primary",
          "enabled": "$can_sync",
          "show": "$configured"
        }
      ],
      "toasts": {
        "syncing": "@ui.toast_syncing",
        "already_running": "@ui.toast_already_running",
        "sync_done": "@ui.toast_sync_done",
        "sync_failed": "@ui.toast_sync_failed",
        "wifi_missing": "@ui.toast_wifi_missing",
        "failed": "@ui.toast_failed"
      }
    },
    "pair": {
      "title": "@ui.pair_screen_title",
      "status": "$status",
      "body": [
        {
          "pair": {
            "url": "$pair_url",
            "code": "$pair_code",
            "title": "@ui.pair_block_title",
            "hint": "$pair_hint",
            "expires": "$pair_expires"
          }
        },
        {
          "notice": "$pair_note"
        }
      ],
      "footer": [
        {
          "button": "@ui.pair_start",
          "action": "pair",
          "style": "primary",
          "show": "!$pairing"
        },
        {
          "button": "@ui.pair_stop",
          "action": "stop-pairing",
          "style": "primary",
          "show": "$pairing"
        }
      ],
      "toasts": {
        "pair_started": "@ui.toast_pair_started",
        "pair_failed": "@ui.toast_pair_failed",
        "pair_stopped": "@ui.toast_pair_stopped",
        "pair_not_running": "@ui.toast_pair_not_running",
        "wifi_missing": "@ui.toast_wifi_missing",
        "failed": "@ui.toast_failed"
      }
    }
  }
}
