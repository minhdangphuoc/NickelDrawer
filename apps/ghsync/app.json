{
  "schema": 1,
  "id": "ghsync",
  "name": "GitHub",
  "version": "0.3.0",
  "description": "Sync books from a private GitHub repo (add-only, never deletes)",
  "storage": {
    "reads": [],
    "writes": [
      "books",
      "documents",
      "comics"
    ]
  },
  "network": true,
  "actions": [
    {
      "id": "sync",
      "label": "Sync now",
      "run": "bin/sync.sh",
      "output": "show",
      "timeout_ms": 9500,
      "wifi": true,
      "rescan": "none"
    },
    {
      "id": "pair",
      "label": "Pair with phone",
      "run": "bin/pair.sh",
      "output": "show",
      "timeout_ms": 9500,
      "wifi": true,
      "rescan": "none",
      "menu": true
    },
    {
      "id": "stop-pairing",
      "label": "Stop pairing",
      "run": "bin/stop-pairing.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "state",
      "label": "Screen state",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 1000,
      "rescan": "none",
      "menu": false
    }
  ],
  "requests": [
    "rescan"
  ]
}
