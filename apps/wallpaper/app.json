{
  "schema": 1,
  "id": "wallpaper",
  "name": "Wallpaper",
  "version": "0.2.0",
  "description": "Use your own pictures as the sleep screen",
  "storage": {
    "reads": [
      "pictures"
    ],
    "writes": [
      "screensaver"
    ]
  },
  "network": false,
  "actions": [
    {
      "id": "import",
      "label": "Import pictures",
      "run": "bin/import.sh",
      "output": "show",
      "timeout_ms": 9500,
      "rescan": "none"
    },
    {
      "id": "mode",
      "label": "Fill / Fit",
      "run": "bin/mode.sh",
      "output": "show",
      "timeout_ms": 9500,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "rotation",
      "label": "Fixed / Random",
      "run": "bin/rotation.sh",
      "output": "show",
      "timeout_ms": 5000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "off",
      "label": "Turn off",
      "run": "bin/off.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "status",
      "label": "Status",
      "run": "bin/status.sh",
      "output": "show",
      "timeout_ms": 3000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "state",
      "label": "Screen state",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 1000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "set-current",
      "label": "Set as wallpaper",
      "run": "bin/set-current.sh",
      "output": "show",
      "timeout_ms": 5000,
      "rescan": "none",
      "menu": false
    },
    {
      "id": "remove",
      "label": "Remove picture",
      "run": "bin/remove.sh",
      "output": "show",
      "timeout_ms": 5000,
      "rescan": "none",
      "menu": false
    }
  ]
}
