{
  "kit": 1,
  "start": "main",
  "vars": {
    "status": "",
    "summary": "",
    "pictures": [],
    "selected": "",
    "current_id": "",
    "count": 0,
    "mode": "fill",
    "rotation": "fixed",
    "busy": false,
    "pending": 0,
    "sleep_screen_ready": true,
    "sleep_screen_hint": "",
    "sleep_screen_notice": "",
    "sleep_screen_line": "",
    "last_import": "",
    "step_label": "",
    "step_done": "",
    "step_total": "",
    "step_detail": ""
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "status": "$status",
      "actions": [
        {
          "icon": "import",
          "label": "@ui.import",
          "action": "import"
        },
        {
          "icon": "settings",
          "label": "@ui.options",
          "push": "options"
        }
      ],
      "body": [
        {
          "text": "$summary",
          "style": "caption"
        },
        {
          "row": "$sleep_screen_notice",
          "push": "options"
        },
        {
          "steps": {
            "label": "$step_label",
            "done": "$step_done",
            "total": "$step_total",
            "detail": "$step_detail"
          }
        },
        {
          "gallery": "$pictures",
          "columns": 4,
          "rows": 3,
          "on_tap": {
            "push": "viewer"
          },
          "on_long_press": [
            {
              "label": "@ui.menu_set",
              "action": "set-current"
            },
            {
              "label": "@ui.menu_view",
              "push": "viewer"
            },
            {
              "label": "@ui.menu_info",
              "info": true
            },
            {
              "label": "@ui.menu_remove",
              "action": "remove",
              "confirm": {
                "title": "@ui.remove_title",
                "text": "@ui.remove_text",
                "ok": "@ui.remove_ok",
                "cancel": "@ui.cancel"
              }
            },
            {
              "label": "@ui.menu_remove_original",
              "action": "remove-all",
              "confirm": {
                "title": "@ui.remove_original_title",
                "text": "@ui.remove_original_text",
                "ok": "@ui.remove_original_ok",
                "cancel": "@ui.cancel"
              }
            }
          ],
          "pending": "$pending",
          "empty": {
            "icon": "picture",
            "title": "@ui.empty_title",
            "text": "@ui.empty_text",
            "button": "@ui.import",
            "action": "import"
          }
        }
      ],
      "toasts": {
        "set": "@ui.toast_set",
        "removed": "@ui.toast_removed",
        "import_started": "@ui.toast_import_started",
        "busy": "@ui.toast_busy",
        "failed": "@ui.toast_failed",
        "removed_original": "@ui.toast_removed_original",
        "removed_original_kept": "@ui.toast_removed_original_kept"
      }
    },
    "viewer": {
      "title": "@ui.viewer_title",
      "body": [
        {
          "viewer": "$pictures",
          "selected": "selected",
          "current_status": "@ui.viewer_current",
          "primary": {
            "label": "@ui.set_wallpaper",
            "label_current": "@ui.in_use",
            "action": "set-current"
          },
          "secondary": {
            "label": "@ui.remove",
            "action": "remove",
            "confirm": {
              "title": "@ui.remove_title",
              "text": "@ui.remove_text",
              "ok": "@ui.remove_ok",
              "cancel": "@ui.cancel"
            }
          }
        }
      ],
      "toasts": {
        "set": "@ui.toast_set",
        "removed": "@ui.toast_removed",
        "failed": "@ui.toast_failed",
        "busy": "@ui.toast_busy"
      }
    },
    "options": {
      "title": "@ui.options",
      "body": [
        {
          "radio": "@ui.mode",
          "bind": "mode",
          "options": [
            [
              "fill",
              "@ui.mode_fill",
              "@ui.mode_fill_detail"
            ],
            [
              "fit",
              "@ui.mode_fit",
              "@ui.mode_fit_detail"
            ]
          ]
        },
        {
          "radio": "@ui.rotation",
          "bind": "rotation",
          "options": [
            [
              "fixed",
              "@ui.rotation_fixed",
              "@ui.rotation_fixed_detail"
            ],
            [
              "random",
              "@ui.rotation_random",
              "@ui.rotation_random_detail"
            ]
          ]
        },
        {
          "notice": "$sleep_screen_line",
          "title": "@ui.section_sleep"
        }
      ],
      "toasts": {
        "mode_started": "@ui.toast_mode_started",
        "failed": "@ui.toast_failed"
      }
    }
  }
}
