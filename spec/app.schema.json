{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koboapps.local/spec/app.schema.json",
  "title": "koboapps app.json v1",
  "description": "See docs/spec/app-format.md. Extra rules not expressible here: id equals the folder name; run must exist and be executable; timeout_ms only with output show.",
  "type": "object",
  "required": ["schema", "id", "name", "version", "actions"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[^:]*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "description": { "type": "string", "maxLength": 120 },
    "menu": { "type": "boolean", "default": true },
    "storage": {
      "type": "object",
      "description": "Logical storage folders (internal/storage) the app reads and writes.",
      "properties": {
        "reads": { "type": "array", "items": { "$ref": "#/$defs/storageName" }, "uniqueItems": true },
        "writes": { "type": "array", "items": { "$ref": "#/$defs/storageName" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "network": { "type": "boolean", "default": false, "description": "The app talks to the network." },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "storageName": { "enum": ["books", "documents", "comics", "pictures", "inbox", "rejected", "screensaver"] },
    "action": {
      "type": "object",
      "required": ["id", "label", "run", "output"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^:]*$" },
        "run": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^:]+$" },
        "output": { "enum": ["show", "none"] },
        "timeout_ms": { "type": "integer", "minimum": 500, "maximum": 9999, "default": 5000 },
        "wifi": { "type": "boolean", "default": false },
        "menu": { "type": "boolean", "default": true },
        "rescan": { "enum": ["none", "quick", "full"], "default": "none" }
      },
      "if": { "properties": { "output": { "const": "none" } }, "required": ["output"] },
      "then": { "not": { "required": ["timeout_ms"] } }
    }
  }
}
