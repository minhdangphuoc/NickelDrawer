#!/bin/sh
# Prints the values of the `vars` in ui.json as one JSON object (docs/spec/drawer-protocol.md).
# Messages used here must not contain double quotes or backslashes.

APP_DIR=$(cd "$(dirname "$0")/.." && pwd)
. /mnt/onboard/.adds/koboapps/lib/common.sh

APP_ID={{.ID}}

runCount=$(cat "$APP_DIR/data/run-count.txt" 2>/dev/null || echo 0)
if [ "$runCount" -eq 0 ]; then
    status=$(msg "$APP_ID" msg.never_run)
else
    status=$(msg "$APP_ID" msg.run_count count="$runCount")
fi
printf '{"status":"%s"}\n' "$status"
