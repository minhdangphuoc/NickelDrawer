{
  "schema": 1,
  "id": "imageview",
  "name": "Image viewer",
  "version": "2.0.0",
  "description": "Packs photos into comic albums for Kobo's own reader",
  "requests": [
    "rescan"
  ],
  "actions": [
    {
      "id": "make-albums",
      "label": "Make albums",
      "run": "bin/make-albums.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "state",
      "label": "State",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 1000,
      "menu": false
    }
  ]
}
