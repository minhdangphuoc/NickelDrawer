{
  "schema": 1,
  "id": "todo",
  "name": "To-do",
  "version": "2.0.0",
  "description": "A small to-do list kept in a text file",
  "actions": [
    {
      "id": "clear-done",
      "label": "Clear done items",
      "run": "bin/clear-done.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "add-from-file",
      "label": "Add from file",
      "run": "bin/add-from-file.sh",
      "output": "show",
      "timeout_ms": 3000
    },
    {
      "id": "newitem",
      "label": "New item",
      "run": "bin/newitem.sh",
      "output": "show",
      "timeout_ms": 3000,
      "menu": false
    },
    {
      "id": "toggle",
      "label": "Toggle done",
      "run": "bin/toggle.sh",
      "output": "show",
      "timeout_ms": 3000,
      "menu": false
    },
    {
      "id": "remove",
      "label": "Remove item",
      "run": "bin/remove.sh",
      "output": "show",
      "timeout_ms": 3000,
      "menu": false
    },
    {
      "id": "hidedone",
      "label": "Hide done items",
      "run": "bin/hidedone.sh",
      "output": "show",
      "timeout_ms": 3000,
      "menu": false
    },
    {
      "id": "state",
      "label": "State",
      "run": "bin/state.sh",
      "output": "show",
      "timeout_ms": 3000,
      "menu": false
    }
  ]
}
