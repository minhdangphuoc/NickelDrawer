{
  "kit": 1,
  "start": "main",
  "vars": {
    "open": "0",
    "done": "0",
    "items": [],
    "hidedone": false,
    "newitem": ""
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "status": "@ui.counts",
      "body": [
        {
          "toggle": "@ui.hide_done",
          "bind": "hidedone"
        },
        {
          "field": "@ui.new_item",
          "bind": "newitem",
          "placeholder": "@ui.new_item_hint",
          "keyboard": "text"
        },
        {
          "list": "$items",
          "title": "@ui.items",
          "empty_text": "@ui.empty",
          "max": 50,
          "tap": "toggle",
          "menu": [
            {
              "id": "remove",
              "label": "@ui.remove",
              "confirm": true
            }
          ]
        },
        {
          "button": "@ui.clear_done",
          "action": "clear-done",
          "style": "secondary",
          "confirm": {
            "text": "@ui.clear_confirm",
            "ok": "@ui.clear_ok",
            "cancel": "@ui.cancel"
          }
        }
      ],
      "footer": [
        {
          "button": "@ui.add_from_file",
          "action": "add-from-file",
          "style": "primary"
        }
      ],
      "toasts": {
        "added": "@ui.toast_added",
        "removed": "@ui.toast_removed",
        "cleared": "@ui.toast_cleared",
        "nothing_done": "@ui.toast_nothing_done",
        "empty": "@ui.toast_empty",
        "inbox_empty": "@ui.toast_inbox_empty",
        "failed": "@ui.toast_failed"
      }
    }
  }
}
