{
  "_preview": "Preview: the native drawer that shows ui.json ships in Phase 3-4. Until then the menu actions in app.json are what runs. Check this screen on a Mac with: ndpreview serve examples/todo",
  "kit": 1,
  "start": "main",
  "vars": {
    "status": "",
    "items": [],
    "hideDone": false
  },
  "screens": {
    "main": {
      "title": { "en": "To-do", "vi": "Việc cần làm" },
      "status": "$status",
      "body": [
        { "toggle": { "en": "Hide done items", "vi": "Ẩn việc đã xong" }, "bind": "hideDone" },
        {
          "list": "$items",
          "title": { "en": "Items", "vi": "Danh sách" },
          "empty_text": { "en": "Nothing to do yet", "vi": "Chưa có việc nào" },
          "max": 50,
          "menu": [
            { "id": "remove", "label": { "en": "Remove...", "vi": "Xóa..." }, "confirm": true }
          ]
        },
        {
          "button": { "en": "Mark next done", "vi": "Xong việc kế tiếp" },
          "action": "done-next",
          "style": "secondary"
        },
        {
          "button": { "en": "Clear done items", "vi": "Xóa việc đã xong" },
          "action": "clear-done",
          "style": "secondary",
          "confirm": {
            "text": { "en": "Remove every item that is marked done?", "vi": "Xóa mọi việc đã đánh dấu xong?" },
            "ok": { "en": "Remove", "vi": "Xóa" },
            "cancel": { "en": "Cancel", "vi": "Hủy" }
          }
        }
      ],
      "footer": [
        {
          "button": { "en": "Add from file", "vi": "Thêm từ tệp" },
          "action": "add-from-file",
          "style": "primary"
        }
      ]
    }
  }
}
