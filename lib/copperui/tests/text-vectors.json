{
  "comment": "Shared wrap/elide vectors. cmd/ndpreview (Go) and mod/drawer/screen_logic.cc (C++, through the generated mod/drawer/tests/text_vectors.inc) must give these results with the deterministic fake font below. Width of a text = (sum of percent of its code points) * size / 100, then * familyPercent / 100, then * boldPercent / 100 when bold, each step in integer arithmetic rounding down. At size 40 a plain letter is 20 px, a space or narrow letter 10 px.",
  "measure": {
    "defaultPercent": 50,
    "wide": {"chars": "MWmw", "percent": 80},
    "narrow": {"chars": " il.,'!|", "percent": 25},
    "familyPercent": {"sans": 100, "serif": 90, "mono": 120},
    "boldPercent": 120
  },
  "cases": [
    {"name": "wrap: fits on one line", "op": "wrap", "text": "hello world", "width": 1000, "size": 40, "family": "sans", "expect": ["hello world"]},
    {"name": "wrap: breaks between words", "op": "wrap", "text": "aaaa bbbb cccc", "width": 100, "size": 40, "family": "sans", "expect": ["aaaa", "bbbb", "cccc"]},
    {"name": "wrap: fills a line greedily", "op": "wrap", "text": "aaaa bbbb cccc dddd", "width": 200, "size": 40, "family": "sans", "expect": ["aaaa bbbb", "cccc dddd"]},
    {"name": "wrap: paragraphs", "op": "wrap", "text": "ab\ncd", "width": 1000, "size": 40, "family": "sans", "expect": ["ab", "cd"]},
    {"name": "wrap: empty paragraphs are skipped", "op": "wrap", "text": "ab\n\ncd", "width": 1000, "size": 40, "family": "sans", "expect": ["ab", "cd"]},
    {"name": "wrap: empty text has no lines", "op": "wrap", "text": "", "width": 1000, "size": 40, "family": "sans", "expect": []},
    {"name": "wrap: extra spaces collapse", "op": "wrap", "text": "  a   b  ", "width": 1000, "size": 40, "family": "sans", "expect": ["a b"]},
    {"name": "wrap: no-break space is a space", "op": "wrap", "text": "a b", "width": 1000, "size": 40, "family": "sans", "expect": ["a b"]},
    {"name": "wrap: a long word is cut", "op": "wrap", "text": "abcdefghij", "width": 100, "size": 40, "family": "sans", "expect": ["abcde", "fghij"]},
    {"name": "wrap: the cut word's last piece takes the next word", "op": "wrap", "text": "abcdefgh ij", "width": 100, "size": 40, "family": "sans", "expect": ["abcde", "fgh ij"]},
    {"name": "wrap: a long word flushes the open line first", "op": "wrap", "text": "ab abcdefgh", "width": 100, "size": 40, "family": "sans", "expect": ["ab", "abcde", "fgh"]},
    {"name": "wrap: wide letters", "op": "wrap", "text": "MMMM", "width": 100, "size": 40, "family": "sans", "expect": ["MMM", "M"]},
    {"name": "wrap: narrow letters", "op": "wrap", "text": "llllllllll", "width": 100, "size": 40, "family": "sans", "expect": ["llllllllll"]},
    {"name": "wrap: bold is wider", "op": "wrap", "text": "aaaa aaaa", "width": 200, "size": 40, "family": "sans", "bold": true, "expect": ["aaaa", "aaaa"]},
    {"name": "wrap: regular fits what bold does not", "op": "wrap", "text": "aaaa aaaa", "width": 200, "size": 40, "family": "sans", "expect": ["aaaa aaaa"]},
    {"name": "wrap: serif is narrower", "op": "wrap", "text": "aaaaaa", "width": 110, "size": 40, "family": "serif", "expect": ["aaaaaa"]},
    {"name": "wrap: mono is wider", "op": "wrap", "text": "aaaaaa", "width": 110, "size": 40, "family": "mono", "expect": ["aaaa", "aa"]},
    {"name": "wrap: a narrower line than one letter still takes one letter", "op": "wrap", "text": "ab", "width": 5, "size": 40, "family": "sans", "expect": ["a", "b"]},
    {"name": "wrap: Vietnamese code points", "op": "wrap", "text": "Ứng dụng của bạn", "width": 200, "size": 40, "family": "sans", "expect": ["Ứng dụng", "của bạn"]},
    {"name": "limited: two lines fit", "op": "wrapLimited", "text": "aaaa bbbb cccc dddd", "width": 200, "size": 40, "family": "sans", "maxLines": 2, "expect": ["aaaa bbbb", "cccc dddd"]},
    {"name": "limited: the second line is elided", "op": "wrapLimited", "text": "aaaa bbbb cccc dddd eeee ffff", "width": 200, "size": 40, "family": "sans", "maxLines": 2, "expect": ["aaaa bbbb", "cccc dddd…"]},
    {"name": "limited: one line is an elide", "op": "wrapLimited", "text": "aaaa bbbb cccc", "width": 200, "size": 40, "family": "sans", "maxLines": 1, "expect": ["aaaa bbbb…"]},
    {"name": "limited: short text is untouched", "op": "wrapLimited", "text": "ok", "width": 200, "size": 40, "family": "sans", "maxLines": 2, "expect": ["ok"]},
    {"name": "limited: grid name, bold button label", "op": "wrapLimited", "text": "Tiếng Việt cho máy đọc sách", "width": 232, "size": 32, "family": "sans", "maxLines": 2, "expect": ["Tiếng Việt cho", "máy đọc sách"]},
    {"name": "elide: fits", "op": "elide", "text": "hello", "width": 1000, "size": 40, "family": "sans", "expect": ["hello"]},
    {"name": "elide: end", "op": "elide", "text": "abcdefghij", "width": 100, "size": 40, "family": "sans", "expect": ["abcd…"]},
    {"name": "elide: trailing space is trimmed before the ellipsis", "op": "elide", "text": "ab cdefgh", "width": 80, "size": 40, "family": "sans", "expect": ["ab…"]},
    {"name": "elide: nothing fits but the ellipsis", "op": "elide", "text": "abcdef", "width": 5, "size": 40, "family": "sans", "expect": ["…"]},
    {"name": "elide: bold", "op": "elide", "text": "abcdefghij", "width": 100, "size": 40, "family": "sans", "bold": true, "expect": ["abc…"]},
    {"name": "elide: middle keeps the file extension", "op": "elideMiddle", "text": "holiday_photo_2024.epub", "width": 300, "size": 40, "family": "sans", "expect": ["holiday…024.epub"]},
    {"name": "elide: middle fits", "op": "elideMiddle", "text": "a.epub", "width": 300, "size": 40, "family": "sans", "expect": ["a.epub"]},
    {"name": "elide: Vietnamese", "op": "elide", "text": "Đang ở màn hình chờ: 12", "width": 300, "size": 32, "family": "sans", "expect": ["Đang ở màn hình chờ…"]}
  ]
}
