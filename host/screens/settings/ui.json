{
  "kit": 1,
  "start": "main",
  "vars": {
    "current": "",
    "source": "",
    "latest": "",
    "latest_label": "",
    "latest_value": "",
    "notes": "",
    "message": "",
    "apply_label": "",
    "can_update": false,
    "can_check": true,
    "debug": false,
    "firmware": "",
    "hidden_app": false,
    "hidden_app_name": "",
    "hidden_app_hint": "",
    "hidden_none": "",
    "version_text": "",
    "project_name": "",
    "project_url": "",
    "project_repo": "",
    "maintainer": "",
    "license": "",
    "firmware_range": ""
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "body": [
        { "section": "@ui.sec_hidden" },
        { "toggle": "$hidden_app_name", "bind": "hidden_app" },
        { "text": "$hidden_app_hint", "style": "caption" },
        { "text": "$hidden_none", "style": "caption" },
        { "text": "@ui.hidden_note", "style": "caption" },
        { "section": "@ui.sec_updates" },
        {
          "kv": [
            ["@ui.current", "$current"],
            ["$latest_label", "$latest_value"],
            ["@ui.source", "$source"]
          ]
        },
        { "notice": "$notes", "title": "@ui.notes_title" },
        { "text": "$message", "style": "caption" },
        { "section": "@ui.sec_debug" },
        { "toggle": "@ui.debug", "bind": "debug" },
        { "text": "@ui.debug_hint", "style": "caption" },
        { "section": "@ui.sec_about" },
        { "kv": [["@ui.firmware", "$firmware"]] },
        { "row": "@ui.about_row", "push": "about" }
      ],
      "footer": [
        { "button": "@ui.check", "action": "check", "style": "secondary", "enabled": "$can_check", "async": true },
        {
          "button": "$apply_label",
          "action": "apply",
          "style": "primary",
          "enabled": "$can_update",
          "async": true,
          "confirm": { "text": "@ui.apply_confirm", "ok": "@ui.apply_ok", "cancel": "@ui.cancel" }
        }
      ],
      "toasts": {
        "check_started": "@ui.toast_check_started",
        "apply_started": "@ui.toast_apply_started",
        "failed": "@ui.toast_failed"
      }
    },
    "about": {
      "title": "@ui.about_title",
      "body": [
        { "text": "$project_name", "style": "heading", "align": "center" },
        { "text": "$version_text", "align": "center" },
        { "text": "@ui.about_desc", "style": "caption", "align": "center" },
        { "qr": "$project_url", "caption": "@ui.qr_caption" },
        { "section": "@ui.sec_project" },
        {
          "kv": [
            ["@ui.maintainer", "$maintainer"],
            ["@ui.github", "$project_repo"],
            ["@ui.guide", "@ui.guide_value"],
            ["@ui.license", "$license"],
            ["@ui.firmware_supported", "$firmware_range"]
          ]
        },
        { "section": "@ui.sec_credits" },
        {
          "kv": [
            ["@ui.credit_nickelhook", "@ui.credit_pgaskin"],
            ["@ui.credit_nickelmenu", "@ui.credit_pgaskin"],
            ["@ui.credit_localgo", "@ui.credit_localgo_value"],
            ["@ui.credit_tabler", "@ui.credit_tabler_value"],
            ["@ui.credit_oksvg", "@ui.credit_oksvg_value"],
            ["@ui.credit_viet", "@ui.credit_viet_value"]
          ]
        },
        { "text": "@ui.about_note", "style": "caption" }
      ]
    }
  }
}
