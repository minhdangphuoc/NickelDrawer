{
  "kit": 1,
  "start": "main",
  "vars": {
    "current": "",
    "source": "",
    "latest": "",
    "latest_label": "",
    "latest_value": "",
    "notes": "",
    "message": "",
    "apply_label": "",
    "can_update": false,
    "can_check": true,
    "debug": false,
    "firmware": "",
    "hidden_app": false,
    "hidden_app_name": "",
    "hidden_app_hint": "",
    "hidden_none": "",
    "version_text": "",
    "project_name": "",
    "project_url": "",
    "project_repo": "",
    "maintainer": "",
    "license": "",
    "firmware_range": "",
    "has_update": false,
    "step_label": "",
    "step_done": "",
    "step_total": "",
    "apps_caption": "",
    "apps_status": "",
    "apps_checked": "",
    "apps_message": "",
    "apps_step_label": "",
    "apps_step_done": "",
    "apps_step_total": "",
    "apps_step_detail": "",
    "apps_update_all_label": "",
    "has_app_updates": false,
    "can_apps_update": false,
    "can_apps_check": true,
    "apps_rows": []
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "body": [
        {
          "section": "@ui.sec_hidden"
        },
        {
          "toggle": "$hidden_app_name",
          "bind": "hidden_app",
          "detail": "$hidden_app_hint"
        },
        {
          "text": "$hidden_none",
          "style": "caption"
        },
        {
          "text": "@ui.hidden_note",
          "style": "caption"
        },
        {
          "section": "@ui.sec_updates"
        },
        {
          "kv": [
            [
              "@ui.current",
              "$current"
            ],
            [
              "$latest_label",
              "$latest_value"
            ],
            [
              "@ui.source",
              "$source"
            ]
          ]
        },
        {
          "row": "@ui.apps_row",
          "detail": "$apps_caption",
          "push": "apps"
        },
        {
          "steps": {
            "label": "$step_label",
            "done": "$step_done",
            "total": "$step_total"
          }
        },
        {
          "notice": "$message"
        },
        {
          "notice": "$notes",
          "title": "@ui.notes_title"
        },
        {
          "section": "@ui.sec_debug"
        },
        {
          "toggle": "@ui.debug",
          "bind": "debug",
          "detail": "@ui.debug_hint"
        },
        {
          "section": "@ui.sec_about"
        },
        {
          "kv": [
            [
              "@ui.firmware",
              "$firmware"
            ]
          ]
        },
        {
          "row": "@ui.about_row",
          "push": "about"
        }
      ],
      "footer": [
        {
          "button": "@ui.check",
          "action": "check",
          "style": "secondary",
          "enabled": "$can_check",
          "show": "$has_update",
          "async": true
        },
        {
          "button": "$apply_label",
          "action": "apply",
          "style": "primary",
          "enabled": "$can_update",
          "show": "$has_update",
          "async": true,
          "confirm": {
            "text": "@ui.apply_confirm",
            "ok": "@ui.apply_ok",
            "cancel": "@ui.cancel"
          }
        },
        {
          "button": "@ui.check",
          "action": "check",
          "style": "primary",
          "enabled": "$can_check",
          "show": "!$has_update",
          "async": true
        }
      ],
      "toasts": {
        "check_started": "@ui.toast_check_started",
        "apply_started": "@ui.toast_apply_started",
        "failed": "@ui.toast_failed"
      }
    },
    "about": {
      "title": "@ui.about_title",
      "body": [
        {
          "text": "$project_name",
          "style": "heading",
          "align": "center"
        },
        {
          "text": "$version_text",
          "align": "center"
        },
        {
          "text": "@ui.about_desc",
          "style": "caption",
          "align": "center"
        },
        {
          "qr": "$project_url",
          "caption": "@ui.qr_caption"
        },
        {
          "section": "@ui.sec_project"
        },
        {
          "kv": [
            [
              "@ui.maintainer",
              "$maintainer"
            ],
            [
              "@ui.github",
              "$project_repo"
            ],
            [
              "@ui.guide",
              "@ui.guide_value"
            ],
            [
              "@ui.license",
              "$license"
            ],
            [
              "@ui.firmware_supported",
              "$firmware_range"
            ]
          ]
        },
        {
          "section": "@ui.sec_credits"
        },
        {
          "kv": [
            [
              "@ui.credit_nickelhook",
              "@ui.credit_pgaskin"
            ],
            [
              "@ui.credit_nickelmenu",
              "@ui.credit_pgaskin"
            ],
            [
              "@ui.credit_localgo",
              "@ui.credit_localgo_value"
            ],
            [
              "@ui.credit_tabler",
              "@ui.credit_tabler_value"
            ],
            [
              "@ui.credit_oksvg",
              "@ui.credit_oksvg_value"
            ],
            [
              "@ui.credit_viet",
              "@ui.credit_viet_value"
            ]
          ]
        },
        {
          "text": "@ui.about_note",
          "style": "caption"
        }
      ]
    },
    "apps": {
      "title": "@ui.apps_title",
      "status": "$apps_status",
      "body": [
        {
          "steps": {
            "label": "$apps_step_label",
            "done": "$apps_step_done",
            "total": "$apps_step_total",
            "detail": "$apps_step_detail"
          }
        },
        {
          "notice": "$apps_message"
        },
        {
          "text": "$apps_checked",
          "style": "caption"
        },
        {
          "row": "@ui.apps_list_marker",
          "action": "apps-list"
        }
      ],
      "footer": [
        {
          "button": "$apps_update_all_label",
          "action": "apps-update-all",
          "style": "primary",
          "enabled": "$can_apps_update",
          "show": "$has_app_updates",
          "async": true
        },
        {
          "button": "@ui.check",
          "action": "apps-check",
          "style": "secondary",
          "enabled": "$can_apps_check",
          "show": "$has_app_updates",
          "async": true
        },
        {
          "button": "@ui.check",
          "action": "apps-check",
          "style": "primary",
          "enabled": "$can_apps_check",
          "show": "!$has_app_updates",
          "async": true
        }
      ],
      "toasts": {
        "check_started": "@ui.toast_apps_check_started",
        "update_started": "@ui.toast_apps_update_started",
        "failed": "@ui.toast_failed"
      }
    }
  }
}
