{
  "kit": 1,
  "start": "main",
  "vars": {
    "current": "",
    "latest": "",
    "notes": "",
    "message": "",
    "can_update": false,
    "can_check": true
  },
  "screens": {
    "main": {
      "title": "@ui.title",
      "body": [
        {
          "kv": [
            ["@ui.current", "$current"],
            ["@ui.latest", "$latest"]
          ]
        },
        { "notice": "$notes", "title": "@ui.notes_title" },
        { "text": "$message", "style": "caption" }
      ],
      "footer": [
        {
          "button": "@ui.apply",
          "action": "apply",
          "style": "primary",
          "enabled": "$can_update",
          "async": true,
          "confirm": { "text": "@ui.apply_confirm", "ok": "@ui.apply_ok", "cancel": "@ui.cancel" }
        },
        { "button": "@ui.check", "action": "check", "style": "secondary", "enabled": "$can_check", "async": true }
      ],
      "toasts": {
        "check_started": "@ui.toast_check_started",
        "apply_started": "@ui.toast_apply_started",
        "failed": "@ui.toast_failed"
      }
    }
  }
}
